{
  "name": "@ni-c/mealie-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.ni-c/mealie-mcp",
  "description": "MCP server for Mealie, the self-hosted recipe manager and meal planner",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mealie",
    "recipes",
    "meal-plan",
    "shopping-list",
    "selfhosted"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/mealie-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/mealie-mcp/issues"
  },
  "homepage": "https://mealie-mcp.ni-c.de",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "bin": {
    "mealie-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "assets": "svg-asset-set",
    "assets:check": "svg-asset-set --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-approval": "^0.8.0",
    "mcp-internal-hosts": "^0.2.1",
    "mcp-tool-allowlist": "^0.2.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "mcp-integration-harness": "^0.4.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "svg-asset-set": "https://github.com/ni-c/svg-asset-set/releases/download/v0.2.0/svg-asset-set-0.2.0.tgz",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
